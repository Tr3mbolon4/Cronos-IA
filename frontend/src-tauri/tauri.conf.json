{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRONOS",
  "version": "0.1.0",
  "identifier": "com.cronos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRONOS",
        "width": 1366,
        "height": 768,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#02050a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
