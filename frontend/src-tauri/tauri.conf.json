{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRONOS",
  "version": "0.2.0",
  "identifier": "com.kalion.cronos",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRONOS",
        "width": 1366,
        "height": 768,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#02050a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kalion Tecnologia",
    "copyright": "Copyright (c) 2026 Kalion Tecnologia",
    "category": "Productivity",
    "shortDescription": "CRONOS Desktop",
    "longDescription": "IA pessoal local CRONOS para Windows.",
    "resources": ["resources/voice/whisper", "resources/ai/llm"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cronos-backend"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "CRONOS"
      }
    }
  }
}
